{
  "name": "talentflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write src server tests *.js *.json *.html README.md"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@napi-rs/canvas": "^1.0.9",
    "adm-zip": "^0.6.1",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "lucide-react": "^1.49.0",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=24.8.0"
