PORT=3001
DATA_DIR=.data
SEED_DEMO=true
# Bật AI bằng cả key và model hỗ trợ Structured Outputs.
OPENAI_API_KEY=
OPENAI_MODEL=
# Chỉ thay đổi nếu dùng nhà cung cấp tương thích Responses API.
AI_BASE_URL=https://api.openai.com/v1
# Tùy chọn: đường dẫn tessdata chứa eng.traineddata.gz và vie.traineddata.gz.
OCR_LANG_PATH=
# Tài khoản khởi tạo được in một lần khi database mới được tạo.
# Có thể đặt mật khẩu khởi tạo riêng (ít nhất 12 ký tự).
BOOTSTRAP_PASSWORD=
SECURE_COOKIE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
